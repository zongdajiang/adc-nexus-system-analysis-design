# Copy to a private env file. Replace placeholders with deployment values.
APP_ENV=PRODUCTION
DEMO_MODE=false
SEED_DATA=false
PORT=10000
BIND_ADDRESS=0.0.0.0
PUBLIC_ORIGIN=https://clinic.example.test
DATABASE_URL=postgresql://adc_app:REPLACE_ME@db.example.test:5432/adc_production?sslmode=verify-full
ORGANIZATION_NAME=REPLACE_WITH_ORGANIZATION_NAME
# First start only. Generate a unique random value with at least 20 characters.
ADMIN_PASSWORD=
