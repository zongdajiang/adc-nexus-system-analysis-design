FROM eclipse-temurin:21-jre-jammy
RUN groupadd --gid 10001 adc && useradd --uid 10001 --gid adc --no-create-home adc \
    && install -d -o adc -g adc /var/adc-nexus
WORKDIR /app
COPY --chown=adc:adc adc-nexus.jar ./adc-nexus.jar
USER adc
EXPOSE 10000
ENTRYPOINT ["java", "-Xms64m", "-Xmx320m", "-XX:MaxMetaspaceSize=96m", "-Dfile.encoding=UTF-8", "-Duser.timezone=Asia/Shanghai", "-jar", "adc-nexus.jar"]
